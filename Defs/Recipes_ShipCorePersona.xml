<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <RecipeDef Name="ShipCorePersonaInstallBase" ParentName="SurgeryInstallImplantBase" Abstract="True">
    <workerClass>ShipCorePersona.Recipe_InstallCorePersonaImplant</workerClass>
    <anesthetize>false</anesthetize>
  </RecipeDef>

  <RecipeDef ParentName="ShipCorePersonaInstallBase">
    <defName>ShipCorePersona_InstallControlSublink</defName>
    <label>install control sublink (standard)</label>
    <description>Install a standard control sublink into the ship core persona. Standard sublinks raise the control group count up to 3.</description>
    <descriptionHyperlinks>
      <ThingDef>ControlSublink</ThingDef>
      <HediffDef>ControlSublinkImplant</HediffDef>
    </descriptionHyperlinks>
    <jobString>Installing control sublink.</jobString>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>ControlSublink</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>ControlSublink</li>
      </thingDefs>
    </fixedIngredientFilter>
    <addsHediff>ControlSublinkImplant</addsHediff>
    <appliedOnFixedBodyParts>
      <li>Brain</li>
    </appliedOnFixedBodyParts>
  </RecipeDef>

